# Copy this file to .env and edit. Never commit .env.

# Which model backend to use: "ollama" (local, free) or "anthropic" (API key, paid).
PROVIDER=ollama

# The ONE folder the harness may access. Relative paths are resolved from the project folder.
# Refused at startup if it is a drive root, your home folder, or contains the project.
WORKSPACE_DIR=workspace

# Where the audit log (one JSONL file per session) is written. Relative paths resolve from the
# project folder. Must NOT be the workspace or inside it. Holds full questions, answers and file
# contents: keep it local (it is git-ignored).
AUDIT_DIR=audit

# File access is only offered to LOCAL models. Set to 1 to let a cloud model (PROVIDER=anthropic)
# read workspace files too; their contents are then sent to the provider.
ALLOW_CLOUD_FILES=0

# --- Ollama (local) ---
OLLAMA_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Anthropic (API key from platform.claude.com) ---
# A Claude Pro/Max subscription can NOT be used here; only a Console API key.
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
