# Copy this file to .env and edit. Never commit .env.

# Which model backend to use: "ollama" (local, free) or "anthropic" (API key, paid).
PROVIDER=ollama

# The ONE folder the harness may access. Relative paths are resolved from the project folder.
# Refused at startup if it is a drive root, your home folder, or contains the project.
WORKSPACE_DIR=workspace

# Where the audit log (one JSONL file per session) is written. Relative paths resolve from the
# project folder. Must NOT be the workspace or inside it. Holds full questions, answers and file
# contents: keep it local (it is git-ignored).
AUDIT_DIR=audit

# File access is only offered to LOCAL models. Set to 1 to let a cloud model (PROVIDER=anthropic)
# read workspace files too; their contents are then sent to the provider.
ALLOW_CLOUD_FILES=0

# Experimental: how the calculator tool takes its arguments ("steps" or "expr"). Default: steps.
# CALC_SHAPE=steps

# Experimental: a tool that looks up one line of a balance sheet, income statement or cash flow statement of a 10-K or 10-Q PDF
# (get_line_item). Off by default. Set to "on" to add it.
# STATEMENT_TOOL=off
# What happens to a figure that cannot be traced to a page or the calculator after the model's one second try:
# redact (default: the sentence is left out) or warn (the answer is shown with a warning line).
# FIGURE_FALLBACK=redact

# The first message of a conversation carries the workspace's file list when it has 20 files or fewer, so the model does not spend a
# reply on list_files. Default: on. Set to "off" to turn it off.
# FILE_LIST_FIRST=on

# Advanced: what happens to the model's earlier reasoning ("thinking") when the conversation is sent back to it.
# "drop" (never sent back), "latest" (only the most recent step's), or "keep" (as the provider library sends it).
# Leave unset to use the provider's default (Ollama: drop). Re-check answers after changing the model or this setting.
# REASONING_HISTORY=drop

# --- Ollama (local) ---
# A full Ollama tag or a short name: "gemma" (gemma4:12b, the default) or "qwen" (qwen3:14b). Override per run with: npm start -- --model qwen
OLLAMA_MODEL=gemma4:12b
OLLAMA_BASE_URL=http://localhost:11434/v1
# The context window (tokens) the harness assumes. Ollama must run with the same size: set the OLLAMA_CONTEXT_LENGTH
# user environment variable AND the "Context length" in the Ollama app's settings, then restart Ollama. Default: 16384.
# OLLAMA_CONTEXT_LENGTH=16384
# Sampling temperature sent with every request (0 to 2; lower is more deterministic). Unset: the model's own default
# from Ollama (gemma4:12b: 1.0). Re-check answers after changing it.
# OLLAMA_TEMPERATURE=

# --- Anthropic (API key from platform.claude.com) ---
# A Claude Pro/Max subscription can NOT be used here; only a Console API key.
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# --- Conversation memory ---
# How much of the earlier conversation the model is shown (the stored chat and the audit log stay complete).
# "auto" (default) picks by the model's context window: under 12,000 tokens strict, under 48,000 balanced, else lenient.
# strict = small history; balanced = a few recent questions whole; lenient = for large-window models; off = send everything.
# In chat, /context shows the numbers and /context <level> changes the level for the session.
# CONTEXT_MEMORY=auto
# Single settings override the level (all optional):
# CONTEXT_HISTORY_SHARE=0.25      # most of the window the earlier conversation may use (0.05 to 0.9)
# CONTEXT_RECENT_GROUPS=2         # finished questions kept whole (0 to 20); older ones keep question and answer
# CONTEXT_KEEP_PREV_PAGES=1       # 1: the last question's page reads stay whole when they fit
# CONTEXT_STUB_OVER=400           # tool results of finished questions longer than this many characters are shortened
# CONTEXT_REPLY_RESERVE=4096      # tokens kept free for the reply
# CONTEXT_CHARS_PER_TOKEN=2.5     # size estimate for text
# CONTEXT_OLDER_FORM=qa           # "qa" (question and answer) or "none" for questions older than the recent ones
# CONTEXT_TRIM_LINE=1             # 1: show a dim line under an answer when the model's view was trimmed
